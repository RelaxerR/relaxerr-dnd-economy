@page "/catalog/{ItemId:guid}"
@using System.Security.Claims
@using DndEconomy.Application.Catalog
@using DndEconomy.Application.Profile
@inject ICatalogQueryService CatalogQueryService
@inject IPlayerProfileService PlayerProfileService

<PageTitle>@(item?.NameRu ?? "Предмет") — Relaxerr</PageTitle>

@if (notFound)
{
  <p class="catalog-meta">Предмет не найден или сейчас нет активной экономической сессии.</p>
  <a href="/catalog">← Вернуться в каталог</a>
}
else if (item is null)
{
  <p>Загрузка...</p>
}
else
{
  <a href="/catalog">← Вернуться в каталог</a>

  <section class="auth-card">
    <h1>@item.NameRu</h1>
    @if (!string.IsNullOrWhiteSpace(item.NameEn))
    {
      <p class="catalog-card__meta">@item.NameEn</p>
    }

    <p class="catalog-card__meta">@item.Category · @item.Type / @item.Subtype</p>
    <p class="catalog-card__meta">Вес: @item.Weight.ToString("0.##")</p>

    @if (item.IsPlayerSuggested)
    {
      <span class="badge badge--player-suggested">Добавлено сообществом</span>
    }
    @if (!item.IsAvailable)
    {
      <span class="badge badge--unavailable">Нет в наличии</span>
    }

    <p class="catalog-card__prices">
      <span>Покупка: @(item.BuyPrice?.ToString("0.##") ?? "—")</span>
      <span>Продажа: @item.SellPrice.ToString("0.##")</span>
    </p>

    <button class="btn btn--primary" @onclick="ToggleFavoriteAsync">
      @(isFavorite ? "Убрать из избранного" : "Сохранить в избранное")
    </button>
  </section>
}

@code {
  [Parameter]
  public Guid ItemId { get; set; }

  [CascadingParameter]
  private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

  private CatalogItemViewModel? item;
  private bool notFound;
  private bool isFavorite;
  private Guid userId;

  protected override async Task OnParametersSetAsync()
  {
    item = await CatalogQueryService.GetItemAsync(ItemId, CancellationToken.None);
    notFound = item is null;

    if (item is null || AuthenticationStateTask is null)
      return;

    var authState = await AuthenticationStateTask;
    var userIdString = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (userIdString is not null && Guid.TryParse(userIdString, out var parsedUserId))
    {
      userId = parsedUserId;
      isFavorite = await PlayerProfileService.IsFavoriteAsync(userId, ItemId, CancellationToken.None);
    }
  }

  private async Task ToggleFavoriteAsync()
  {
    if (userId == Guid.Empty)
      return;

    if (isFavorite)
      await PlayerProfileService.RemoveFavoriteAsync(userId, ItemId, CancellationToken.None);
    else
      await PlayerProfileService.AddFavoriteAsync(userId, ItemId, note: null, CancellationToken.None);

    isFavorite = !isFavorite;
  }
}
