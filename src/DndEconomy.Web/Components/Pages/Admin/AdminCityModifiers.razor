@page "/admin/economy/city-modifiers"
@rendermode InteractiveServer
@using System.Globalization
@using DndEconomy.Application.Economy
@using DndEconomy.Application.Import
@using DndEconomy.Domain.Constants
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IEconomyAdminService EconomyAdminService
@inject IExcelEconomyImportService ExcelImportService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>Коэффициенты городов — админка Relaxerr</PageTitle>
<ToastContainer />

<h1>Экономические сессии и города</h1>
<AdminNav />
<EconomySubNav />

<p class="catalog-meta">
  Коэффициент — множитель к базовой стоимости товаров с этим Типом+Подтипом в этом городе;
  0 означает «не продаётся» (в каталоге — «Нет в наличии»). Строки — все категории (Тип+Подтип),
  которые реально встречаются у предметов каталога, подставляются сюда автоматически, заводить
  их вручную не нужно. Пустых ячеек в таблице нет — всё, что не заведено явно, и так уже
  считается коэффициентом 1 (без изменений). Строки, помеченные «не используется предметами»,
  — коэффициенты, оставшиеся от категории, которой больше нет ни у одного предмета; их можно
  удалить, чтобы не путались. Строки, помеченные бейджем «услуга» (например, «Обмен валют»), —
  исключение из общего правила: коэффициент там — доля суммы после комиссии, а не наценка/скидка,
  и пустая ячейка означает «услуга в этом городе не оказывается», а не коэффициент 1.
</p>

@if (matrix is null)
{
  <p>Загрузка...</p>
}
else if (matrix.Cities.Count == 0)
{
  <p class="catalog-meta">Сначала добавьте хотя бы один город на вкладке «Города».</p>
}
else
{
  <div class="admin-table-wrap">
    <table class="admin-table admin-matrix-table">
      <thead>
        <tr>
          <th>Тип</th>
          <th>Подтип</th>
          @foreach (var city in matrix.Cities)
          {
            <th>@city.Name</th>
          }
          <th></th>
        </tr>
      </thead>
      <tbody>
        @if (matrix.Rows.Count == 0)
        {
          <tr><td colspan="@(matrix.Cities.Count + 3)" class="catalog-meta">Сначала добавьте хотя бы один предмет в каталог — категории появятся здесь автоматически.</td></tr>
        }
        @foreach (var row in matrix.Rows)
        {
          <tr>
            <td>
              @row.Type
              @if (row.IsService)
              {
                <span class="badge badge--player-suggested" title="Для услуг коэффициент — это доля от суммы, которую вернут игроку после комиссии (0.93 = комиссия 7%), а не наценка/скидка к цене товара. Отсутствие ячейки для города означает «услуга здесь не оказывается», а НЕ коэффициент 1.">услуга</span>
              }
              @if (row.IsOrphan)
              {
                <span class="badge" title="Предметов с этим Типом+Подтипом в каталоге больше нет — коэффициенты остались от удалённой/переименованной категории.">не используется предметами</span>
              }
            </td>
            <td>@row.Subtype</td>
            @foreach (var city in matrix.Cities)
            {
              var cityId = city.Id;
              var rowType = row.Type;
              var rowSubtype = row.Subtype;
              var currentValue = row.CoefficientsByCityId.GetValueOrDefault(cityId, 1m);
              <td>
                <input type="number" step="0.01" class="admin-matrix-table__input"
                       value="@currentValue.ToString(CultureInfo.InvariantCulture)"
                       @onchange="e => SaveCellAsync(rowType, rowSubtype, cityId, e.Value)" />
              </td>
            }
            <td>
              @if (row.IsOrphan)
              {
                <button type="button" class="btn admin-matrix-table__delete" @onclick="() => DeleteRowAsync(row.Type, row.Subtype)">Удалить</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

<ExcelSheetPanel Title="Города" SheetName="Города" ExportUrl="/api/admin/economy/cities/export"
                 ImportFunc="ExcelImportService.ImportCitiesAsync" OnImported="ReloadAsync" />

@code {
  private CityModifierMatrix? matrix;

  protected override async Task OnInitializedAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    matrix = await EconomyAdminService.GetCityModifierMatrixAsync(CancellationToken.None);
  }

  private async Task SaveCellAsync(string type, string subtype, Guid cityId, object? value)
  {
    if (!decimal.TryParse(value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var coefficient))
      return;

    await EconomyAdminService.SetCityModifierAsync(type, subtype, cityId, coefficient, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Коэффициент обновлён");
  }

  private async Task DeleteRowAsync(string type, string subtype)
  {
    var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить коэффициенты «{type} / {subtype}» для всех городов?");
    if (!confirmed)
      return;

    await EconomyAdminService.DeleteCityModifierRowAsync(type, subtype, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Строка удалена");
  }
}
