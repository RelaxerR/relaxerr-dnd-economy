@page "/admin/economy/city-modifiers"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using DndEconomy.Application.Catalog
@using DndEconomy.Application.Economy
@using DndEconomy.Domain.Constants
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IEconomyAdminService EconomyAdminService
@inject ICatalogReadStore CatalogReadStore
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>Коэффициенты городов — админка Relaxerr</PageTitle>
<ToastContainer />

<h1>Экономические сессии и города</h1>
<AdminNav />
<EconomySubNav />

<p class="catalog-meta">
  Коэффициент — множитель к базовой стоимости товаров с этим Типом+Подтипом в этом городе;
  0 означает «не продаётся» (в каталоге — «Нет в наличии»). Пустых ячеек в таблице нет —
  всё, что не заведено явно, и так уже считается коэффициентом 1 (без изменений). Тип и
  Подтип должны в точности совпадать с указанными у предмета на странице «Новый предмет» —
  иначе коэффициент ни к одному товару не применится. То же самое можно загрузить файлом
  на странице «Импорт Excel» (лист «Города», шаблон — <code>economy-cities.xlsx</code>).
</p>

@if (error is not null)
{
  <div class="status-message status-message--error">@error</div>
}

@if (matrix is null)
{
  <p>Загрузка...</p>
}
else if (matrix.Cities.Count == 0)
{
  <p class="catalog-meta">Сначала добавьте хотя бы один город на вкладке «Города».</p>
}
else
{
  <div class="admin-table-wrap">
    <table class="admin-table admin-matrix-table">
      <thead>
        <tr>
          <th>Тип</th>
          <th>Подтип</th>
          @foreach (var city in matrix.Cities)
          {
            <th>@city.Name</th>
          }
          <th></th>
        </tr>
      </thead>
      <tbody>
        @if (matrix.Rows.Count == 0)
        {
          <tr><td colspan="@(matrix.Cities.Count + 3)" class="catalog-meta">Коэффициентов пока нет — добавьте первую строку ниже.</td></tr>
        }
        @foreach (var row in matrix.Rows)
        {
          <tr>
            <td>@row.Type</td>
            <td>@row.Subtype</td>
            @foreach (var city in matrix.Cities)
            {
              var cityId = city.Id;
              var rowType = row.Type;
              var rowSubtype = row.Subtype;
              var currentValue = row.CoefficientsByCityId.GetValueOrDefault(cityId, 1m);
              <td>
                <input type="number" step="0.01" class="admin-matrix-table__input"
                       value="@currentValue.ToString(CultureInfo.InvariantCulture)"
                       @onchange="e => SaveCellAsync(rowType, rowSubtype, cityId, e.Value)" />
              </td>
            }
            <td>
              <button type="button" class="btn admin-matrix-table__delete" @onclick="() => DeleteRowAsync(row.Type, row.Subtype)">Удалить</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

<section class="auth-card">
  <h2>Добавить строку (Тип + Подтип)</h2>
  <EditForm Model="newRow" OnValidSubmit="AddRowAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />
    <div class="form-field"><label>Тип</label><InputText @bind-Value="newRow.Type" list="city-mod-type-options" /></div>
    <div class="form-field"><label>Подтип</label><InputText @bind-Value="newRow.Subtype" list="city-mod-subtype-options" /></div>
    <button type="submit" class="btn btn--primary">Добавить строку</button>
  </EditForm>
</section>

<datalist id="city-mod-type-options">
  @foreach (var type in types)
  {
    <option value="@type" />
  }
</datalist>
<datalist id="city-mod-subtype-options">
  @foreach (var subtype in subtypes)
  {
    <option value="@subtype" />
  }
</datalist>

@code {
  private CityModifierMatrix? matrix;
  private IReadOnlyList<string> types = [];
  private IReadOnlyList<string> subtypes = [];
  private NewRowModel newRow = new();
  private string? error;

  protected override async Task OnInitializedAsync()
  {
    types = await CatalogReadStore.GetDistinctTypesAsync(null, CancellationToken.None);
    subtypes = await CatalogReadStore.GetDistinctSubtypesAsync(null, CancellationToken.None);
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    matrix = await EconomyAdminService.GetCityModifierMatrixAsync(CancellationToken.None);
  }

  private async Task SaveCellAsync(string type, string subtype, Guid cityId, object? value)
  {
    if (!decimal.TryParse(value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var coefficient))
      return;

    await EconomyAdminService.SetCityModifierAsync(type, subtype, cityId, coefficient, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Коэффициент обновлён");
  }

  private async Task AddRowAsync()
  {
    error = null;

    if (matrix is null || matrix.Cities.Count == 0)
      return;

    if (matrix.Rows.Any(r => r.Type == newRow.Type && r.Subtype == newRow.Subtype))
    {
      error = $"Строка «{newRow.Type} / {newRow.Subtype}» уже есть — отредактируйте коэффициенты прямо в таблице.";
      return;
    }

    foreach (var city in matrix.Cities)
    {
      await EconomyAdminService.SetCityModifierAsync(newRow.Type, newRow.Subtype, city.Id, 1m, CancellationToken.None);
    }

    newRow = new();
    await ReloadAsync();
    ToastService.ShowSuccess("Строка добавлена");
  }

  private async Task DeleteRowAsync(string type, string subtype)
  {
    var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить коэффициенты «{type} / {subtype}» для всех городов?");
    if (!confirmed)
      return;

    await EconomyAdminService.DeleteCityModifierRowAsync(type, subtype, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Строка удалена");
  }

  private sealed class NewRowModel
  {
    [Required] public string Type { get; set; } = "";
    [Required] public string Subtype { get; set; } = "";
  }
}
