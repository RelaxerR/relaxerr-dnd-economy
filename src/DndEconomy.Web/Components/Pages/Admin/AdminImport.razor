@page "/admin/import"
@rendermode InteractiveServer
@using DndEconomy.Application.Import
@using DndEconomy.Domain.Constants
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IExcelEconomyImportService ImportService
@inject ToastService ToastService

<PageTitle>Импорт из Excel — админка Relaxerr</PageTitle>
<ToastContainer />

<h1>Импорт исходной таблицы (Excel)</h1>
<AdminNav />
<p class="catalog-meta">
  Файл можно перезаливать — записи обновляются по ключу, а не дублируются. Не обязательно грузить
  всё сразу одним файлом: предметы, города, сезонность и настройки (сессии) можно загружать по
  отдельности — каждый лист импортируется, если он есть в книге. Шаблоны — в папке
  <code>/templates</code> репозитория.
</p>

<section class="auth-card">
  <InputFile OnChange="OnFileSelectedAsync" />

  @if (isImporting)
  {
    <p>Импортирую...</p>
  }

  @if (summary is not null)
  {
    <div class="status-message status-message--success">
      <p>Предметов: @summary.ItemsImported, городов: @summary.CitiesImported,
        коэф. города: @summary.CityModifiersImported, коэф. сезона: @summary.SeasonModifiersImported,
        сессий: @summary.SessionsImported.</p>
      @foreach (var warning in summary.Warnings)
      {
        <p>⚠ @warning</p>
      }
    </div>
  }

  @if (error is not null)
  {
    <div class="status-message status-message--error">@error</div>
  }
</section>

@code {
  private bool isImporting;
  private EconomyImportSummary? summary;
  private string? error;

  private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
  {
    summary = null;
    error = null;
    isImporting = true;

    try
    {
      // BrowserFileStream (Blazor Server) не поддерживает Seek, а ClosedXML читает xlsx как
      // ZIP-контейнер — нужен произвольный доступ к центральной директории в конце файла.
      await using var browserStream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
      using var seekableStream = new MemoryStream();
      await browserStream.CopyToAsync(seekableStream);
      seekableStream.Position = 0;

      summary = await ImportService.ImportAsync(seekableStream, CancellationToken.None);
      ToastService.ShowSuccess("Импорт завершён успешно");
    }
    catch (Exception ex)
    {
      error = $"Ошибка импорта: {ex.Message}";
    }
    finally
    {
      isImporting = false;
    }
  }
}
