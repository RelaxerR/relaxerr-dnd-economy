@page "/admin/economy/season-modifiers"
@rendermode InteractiveServer
@using System.Globalization
@using DndEconomy.Application.Economy
@using DndEconomy.Application.Import
@using DndEconomy.Domain.Constants
@using DndEconomy.Domain.Enums
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IEconomyAdminService EconomyAdminService
@inject IExcelEconomyImportService ExcelImportService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>Коэффициенты сезонов — админка Relaxerr</PageTitle>
<ToastContainer />

<h1>Экономические сессии и города</h1>
<AdminNav />
<EconomySubNav />

<p class="catalog-meta">
  Коэффициент — множитель к базовой стоимости товаров с этим Типом+Подтипом в этом сезоне.
  Строки — все категории (Тип+Подтип), которые реально встречаются у предметов каталога,
  подставляются сюда автоматически, заводить их вручную не нужно. Пустых ячеек в таблице нет —
  всё, что не заведено явно, и так уже считается коэффициентом 1 (без изменений). Строки,
  помеченные «не используется предметами», — коэффициенты, оставшиеся от категории, которой
  больше нет ни у одного предмета; их можно удалить, чтобы не путались.
</p>

@if (rows is null)
{
  <p>Загрузка...</p>
}
else
{
  <div class="admin-table-wrap">
    <table class="admin-table admin-matrix-table">
      <thead>
        <tr>
          <th>Тип</th>
          <th>Подтип</th>
          @foreach (var season in Seasons)
          {
            <th>@SeasonLabel(season)</th>
          }
          <th></th>
        </tr>
      </thead>
      <tbody>
        @if (rows.Count == 0)
        {
          <tr><td colspan="@(Seasons.Length + 3)" class="catalog-meta">Сначала добавьте хотя бы один предмет в каталог — категории появятся здесь автоматически.</td></tr>
        }
        @foreach (var row in rows)
        {
          <tr>
            <td>
              @row.Type
              @if (row.IsOrphan)
              {
                <span class="badge" title="Предметов с этим Типом+Подтипом в каталоге больше нет — коэффициенты остались от удалённой/переименованной категории.">не используется предметами</span>
              }
            </td>
            <td>@row.Subtype</td>
            @foreach (var season in Seasons)
            {
              var rowType = row.Type;
              var rowSubtype = row.Subtype;
              var currentSeason = season;
              var currentValue = row.CoefficientsBySeason.GetValueOrDefault(currentSeason, 1m);
              <td>
                <input type="number" step="0.01" class="admin-matrix-table__input"
                       value="@currentValue.ToString(CultureInfo.InvariantCulture)"
                       @onchange="e => SaveCellAsync(rowType, rowSubtype, currentSeason, e.Value)" />
              </td>
            }
            <td>
              @if (row.IsOrphan)
              {
                <button type="button" class="btn admin-matrix-table__delete" @onclick="() => DeleteRowAsync(row.Type, row.Subtype)">Удалить</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

<ExcelSheetPanel Title="Сезонность" SheetName="Сезонность" ExportUrl="/api/admin/economy/season-modifiers/export"
                 ImportFunc="ExcelImportService.ImportSeasonModifiersAsync" OnImported="ReloadAsync" />

@code {
  private static readonly Season[] Seasons = [Season.Spring, Season.Summer, Season.Autumn, Season.Winter];

  private IReadOnlyList<SeasonModifierMatrixRow>? rows;

  protected override async Task OnInitializedAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    rows = await EconomyAdminService.GetSeasonModifierMatrixAsync(CancellationToken.None);
  }

  private async Task SaveCellAsync(string type, string subtype, Season season, object? value)
  {
    if (!decimal.TryParse(value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var coefficient))
      return;

    await EconomyAdminService.SetSeasonModifierAsync(type, subtype, season, coefficient, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Коэффициент обновлён");
  }

  private async Task DeleteRowAsync(string type, string subtype)
  {
    var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить коэффициенты «{type} / {subtype}» для всех сезонов?");
    if (!confirmed)
      return;

    await EconomyAdminService.DeleteSeasonModifierRowAsync(type, subtype, CancellationToken.None);
    await ReloadAsync();
    ToastService.ShowSuccess("Строка удалена");
  }

  private static string SeasonLabel(Season season) => season switch
  {
    Season.Spring => "Весна",
    Season.Summer => "Лето",
    Season.Autumn => "Осень",
    Season.Winter => "Зима",
    _ => season.ToString()
  };
}
