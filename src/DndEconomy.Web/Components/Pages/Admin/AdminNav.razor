@inject NavigationManager NavigationManager

<nav class="admin-nav">
  <a class="admin-nav__link @(IsActive("/admin/requests") ? "admin-nav__link--active" : "")" href="/admin/requests">Заявки</a>
  <a class="admin-nav__link @(IsActive("/admin/items/new") ? "admin-nav__link--active" : "")" href="/admin/items/new">Новый предмет</a>
  <a class="admin-nav__link @(IsActive("/admin/economy") ? "admin-nav__link--active" : "")" href="/admin/economy">Города и сессии</a>
  <a class="admin-nav__link @(IsActive("/admin/users") ? "admin-nav__link--active" : "")" href="/admin/users">Пользователи</a>
  <a class="admin-nav__link @(IsActive("/admin/import") ? "admin-nav__link--active" : "")" href="/admin/import">Импорт Excel</a>
</nav>

@code {
  private bool IsActive(string path)
    => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Equals(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
}
