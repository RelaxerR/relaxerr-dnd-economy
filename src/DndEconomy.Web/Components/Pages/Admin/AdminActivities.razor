@page "/admin/activities"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using DndEconomy.Application.Activities
@using DndEconomy.Application.Import
@using DndEconomy.Domain.Constants
@using DndEconomy.Domain.Enums
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IEconomyActivityAdminService EconomyActivityAdminService
@inject IExcelEconomyImportService ExcelImportService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>Экономическая активность — Relaxerr</PageTitle>
<ToastContainer />

<h1>Экономическая активность</h1>

<p class="catalog-meta">
  Ставки дохода/расхода в зм за день <strong>на одного игрока</strong> — партийные задания и занятия
  в простое. Отрицательная ставка — расход (обучение, кутёж). Выплата за контракт — это
  <em>ставка × рекомендуемая длительность</em>, считается один раз фиксированной суммой и не
  пересчитывается от фактически потраченных у стола дней; бонусы за скорость и штрафы за срыв сроков —
  на усмотрение мастера. Только для мастера, игроки эту страницу не видят. Доход партии за период —
  на странице <a href="/admin/economy/income-calculator">калькулятора дохода</a>.
</p>

<section class="auth-card admin-card--wide">
  <div class="admin-card__header">
    <h2>Справочник</h2>
    <button type="button" class="btn btn--primary" @onclick="OpenCreateModal">+ Добавить активность</button>
  </div>

  <div class="catalog-toolbar catalog-toolbar--labelled">
    <label class="catalog-toolbar__field">
      Поиск
      <input type="search" placeholder="Категория, описание…" value="@searchTerm" @oninput="OnSearchInput" />
    </label>

    <label class="catalog-toolbar__field">
      Тип
      <select @bind="typeFilter" @bind:after="OnFiltersChangedAsync">
        <option value="">Все типы</option>
        @foreach (var type in EconomyActivityLabels.TypeOrder)
        {
          <option value="@type">@EconomyActivityLabels.Type(type)</option>
        }
      </select>
    </label>

    <label class="catalog-toolbar__field">
      Уровень персонажей
      <input type="number" min="1" max="20" placeholder="Любой"
             @bind="levelFilter" @bind:event="oninput" @bind:after="OnFiltersChangedAsync" />
    </label>
  </div>

  @if (activities is null)
  {
    <p>Загрузка...</p>
  }
  else if (activities.Count == 0)
  {
    <p class="catalog-meta">Активностей пока нет — добавьте вручную или загрузите лист Excel ниже.</p>
  }
  else
  {
    var filtered = FilteredActivities();
    var pageNumberClamped = ClampPage(pageNumber, filtered.Count);

    @if (filtered.Count == 0)
    {
      <p class="catalog-meta">Ничего не найдено.</p>
    }
    else
    {
      <p class="catalog-meta">Найдено активностей: @filtered.Count. Ставки — зм в день на одного игрока, «за контракт» — ставка × рекомендуемые дни. Кликните по строке, чтобы отредактировать или удалить.</p>

      <div class="admin-table-wrap">
        <table class="admin-table admin-table--clickable">
          <thead>
            <tr>
              <th>Тип</th>
              <th>Категория</th>
              <th>Опасность</th>
              <th>Уровни</th>
              <th title="зм в день на одного игрока">Ставка/день</th>
              <th title="Рекомендуемая длительность">Дней</th>
              <th title="Ставка × рекомендуемая длительность, зм на одного игрока">За контракт</th>
              <th class="admin-table__name-col">Описание</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var activity in filtered.Skip((pageNumberClamped - 1) * PageSize).Take(PageSize))
            {
              <tr @onclick="() => OpenEditModal(activity)">
                <td>@EconomyActivityLabels.Type(activity.ActivityType)</td>
                <td>@activity.Category</td>
                <td>@(activity.DangerLevel is { } danger ? EconomyActivityLabels.Danger(danger) : "—")</td>
                <td>@activity.MinLevel–@activity.MaxLevel</td>
                <td>@FormatRange(activity.RateMin, activity.RateMax)</td>
                <td>@activity.RecommendedDurationDays</td>
                <td>@FormatRange(activity.RateMin * activity.RecommendedDurationDays, activity.RateMax * activity.RecommendedDurationDays)</td>
                <td class="admin-table__name-col">
                  @activity.Description
                  @if (!string.IsNullOrWhiteSpace(activity.BalanceNote))
                  {
                    <div class="catalog-meta admin-table__note">@activity.BalanceNote</div>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <AdminPager PageNumber="pageNumberClamped" PageNumberChanged="p => pageNumber = p" PageSize="PageSize" TotalCount="filtered.Count" />
    }
  }
</section>

@if (editingActivity is not null)
{
  <div class="modal-backdrop" @onclick="CloseEditModal">
    <div class="modal-card" @onclick:stopPropagation="true">
      <h2>@(editingActivityId is null ? "Добавить активность" : "Редактировать активность")</h2>
      @if (editError is not null)
      {
        <div class="status-message status-message--error">@editError</div>
      }
      <EditForm Model="editingActivity" OnValidSubmit="SaveEditAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        @ActivityFields(editingActivity)

        <div class="modal-card__actions">
          <button type="submit" class="btn btn--primary">@(editingActivityId is null ? "Добавить" : "Сохранить")</button>
          <button type="button" class="btn" @onclick="CloseEditModal">Отмена</button>
          @if (editingActivityId is not null)
          {
            <button type="button" class="btn modal-card__delete" @onclick="DeleteEditingActivityAsync">Удалить</button>
          }
        </div>
      </EditForm>
    </div>
  </div>
}

<ExcelSheetPanel Title="Экономическая активность" SheetName="Экономическая активность" ExportUrl="/api/admin/activities/export"
                 ImportFunc="ExcelImportService.ImportEconomyActivitiesAsync" OnImported="ReloadAsync" AlwaysReplaces="true" />

@code {
  private const int PageSize = 20;
  private const int SearchDebounceMilliseconds = 300;
  private const string FiltersStorageKey = "dndeconomy.admin.activities.filters";

  private IReadOnlyList<EconomyActivitySummary>? activities;
  private string searchTerm = "";
  private string typeFilter = "";
  private int? levelFilter;
  private int pageNumber = 1;
  private CancellationTokenSource? searchDebounceCts;

  // editingActivity null — модалка закрыта; editingActivityId null при открытой модалке — создание.
  private Guid? editingActivityId;
  private ActivityFormModel? editingActivity;
  private string? editError;

  /// <summary>
  /// Поля формы активности — общие для создания и редактирования в одной модалке. Выбор
  /// опасности показывается только у заданий: у простоя её нет (сервис сбрасывает её в null).
  /// </summary>
  private RenderFragment ActivityFields(ActivityFormModel model) =>
    @<text>
      <div class="form-field">
        <label>Тип</label>
        <InputSelect @bind-Value="model.ActivityType">
          @foreach (var type in EconomyActivityLabels.TypeOrder)
          {
            <option value="@type">@EconomyActivityLabels.Type(type)</option>
          }
        </InputSelect>
      </div>
      <div class="form-field"><label>Категория</label><InputText @bind-Value="model.Category" /></div>
      @if (model.ActivityType == EconomyActivityType.Quest)
      {
        <div class="form-field">
          <label>Опасность</label>
          <InputSelect @bind-Value="model.DangerLevel">
            @foreach (var danger in EconomyActivityLabels.DangerOrder)
            {
              <option value="@danger">@EconomyActivityLabels.Danger(danger)</option>
            }
          </InputSelect>
        </div>
      }
      <div class="form-field"><label>Мин. уровень</label><InputNumber @bind-Value="model.MinLevel" min="1" max="20" /></div>
      <div class="form-field"><label>Макс. уровень</label><InputNumber @bind-Value="model.MaxLevel" min="1" max="20" /></div>
      <div class="form-field"><label>Ставка мин (зм/день на игрока)</label><InputNumber @bind-Value="model.RateMin" step="0.01" /></div>
      <div class="form-field"><label>Ставка макс (зм/день на игрока)</label><InputNumber @bind-Value="model.RateMax" step="0.01" /></div>
      <div class="form-field"><label>Рекомендуемая длительность (дни)</label><InputNumber @bind-Value="model.RecommendedDurationDays" min="1" /></div>
      <div class="form-field"><label>Описание</label><InputTextArea @bind-Value="model.Description" rows="2" /></div>
      <div class="form-field"><label>Примечание по балансу</label><InputTextArea @bind-Value="model.BalanceNote" rows="2" /></div>
    </text>;

  protected override async Task OnInitializedAsync()
  {
    await ReloadAsync();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
      return;

    var saved = await JSRuntime.LoadFiltersAsync<ActivityFiltersState>(FiltersStorageKey);
    if (saved is null)
      return;

    searchTerm = saved.SearchTerm;
    typeFilter = saved.Type;
    levelFilter = saved.Level;
    StateHasChanged();
  }

  private async Task ReloadAsync()
  {
    activities = await EconomyActivityAdminService.GetAllAsync(CancellationToken.None);
  }

  /// <summary>
  /// Фильтрация в памяти — справочник одной кампании измеряется десятками-сотнями строк,
  /// отдельный запрос в БД на каждый ввод здесь не нужен.
  /// </summary>
  private List<EconomyActivitySummary> FilteredActivities()
  {
    IEnumerable<EconomyActivitySummary> result = activities!;

    if (Enum.TryParse<EconomyActivityType>(typeFilter, out var type))
      result = result.Where(x => x.ActivityType == type);

    if (levelFilter is { } level)
      result = result.Where(x => x.MinLevel <= level && level <= x.MaxLevel);

    var term = searchTerm.Trim();
    if (term.Length > 0)
      result = result.Where(x => ContainsTerm(x.Category, term) || ContainsTerm(x.Description, term) || ContainsTerm(x.BalanceNote, term));

    return result.ToList();
  }

  private static bool ContainsTerm(string? text, string term) => text?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true;

  private static int ClampPage(int page, int totalCount)
    => Math.Clamp(page, 1, Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize)));

  private void OnSearchInput(ChangeEventArgs e)
  {
    searchTerm = e.Value?.ToString() ?? "";

    searchDebounceCts?.Cancel();
    var cts = new CancellationTokenSource();
    searchDebounceCts = cts;

    _ = DebounceSearchAsync(cts.Token);
  }

  private async Task DebounceSearchAsync(CancellationToken token)
  {
    try
    {
      await Task.Delay(SearchDebounceMilliseconds, token);
    }
    catch (TaskCanceledException)
    {
      return;
    }

    await InvokeAsync(async () =>
    {
      await OnFiltersChangedAsync();
      StateHasChanged();
    });
  }

  private Task OnFiltersChangedAsync()
  {
    pageNumber = 1;
    return JSRuntime.SaveFiltersAsync(FiltersStorageKey, new ActivityFiltersState(searchTerm, typeFilter, levelFilter));
  }

  private void OpenCreateModal()
  {
    editingActivityId = null;
    editError = null;
    editingActivity = new ActivityFormModel
    {
      ActivityType = Enum.TryParse<EconomyActivityType>(typeFilter, out var type) ? type : EconomyActivityType.Quest
    };
  }

  private void OpenEditModal(EconomyActivitySummary activity)
  {
    editingActivityId = activity.Id;
    editError = null;
    editingActivity = ActivityFormModel.From(activity);
  }

  private void CloseEditModal()
  {
    editingActivityId = null;
    editingActivity = null;
    editError = null;
  }

  private async Task SaveEditAsync()
  {
    if (editingActivity is null)
      return;

    var isNew = editingActivityId is null;

    try
    {
      if (isNew)
        await EconomyActivityAdminService.CreateAsync(editingActivity.ToInput(), CancellationToken.None);
      else
        await EconomyActivityAdminService.UpdateAsync(editingActivityId!.Value, editingActivity.ToInput(), CancellationToken.None);
    }
    catch (ArgumentException ex)
    {
      editError = ex.Message;
      return;
    }

    CloseEditModal();
    await ReloadAsync();
    ToastService.ShowSuccess(isNew ? "Активность добавлена" : "Активность обновлена");
  }

  private async Task DeleteEditingActivityAsync()
  {
    if (editingActivityId is null)
      return;

    var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Удалить эту активность безвозвратно?");
    if (!confirmed)
      return;

    await EconomyActivityAdminService.DeleteAsync(editingActivityId.Value, CancellationToken.None);
    CloseEditModal();
    await ReloadAsync();
    ToastService.ShowSuccess("Активность удалена");
  }

  private static string FormatRange(decimal min, decimal max)
    => min == max ? FormatGold(min) : $"{FormatGold(min)} … {FormatGold(max)}";

  private static string FormatGold(decimal value) => value.ToString("0.##", CultureInfo.GetCultureInfo("ru-RU"));

  private sealed record ActivityFiltersState(string SearchTerm, string Type, int? Level);

  private sealed class ActivityFormModel
  {
    public EconomyActivityType ActivityType { get; set; } = EconomyActivityType.Quest;
    [Required(ErrorMessage = "Укажите категорию")] public string Category { get; set; } = "";
    public QuestDangerLevel DangerLevel { get; set; } = QuestDangerLevel.Standard;
    [Range(1, 20)] public int MinLevel { get; set; } = 1;
    [Range(1, 20)] public int MaxLevel { get; set; } = 4;
    public decimal RateMin { get; set; }
    public decimal RateMax { get; set; }
    [Range(1, int.MaxValue, ErrorMessage = "Длительность — не меньше 1 дня")] public int RecommendedDurationDays { get; set; } = 1;
    public string Description { get; set; } = "";
    public string BalanceNote { get; set; } = "";

    public NewEconomyActivityInput ToInput() => new()
    {
      ActivityType = ActivityType,
      Category = Category,
      DangerLevel = ActivityType == EconomyActivityType.Quest ? DangerLevel : null,
      MinLevel = MinLevel,
      MaxLevel = MaxLevel,
      RateMin = RateMin,
      RateMax = RateMax,
      RecommendedDurationDays = RecommendedDurationDays,
      Description = Description,
      BalanceNote = BalanceNote
    };

    public static ActivityFormModel From(EconomyActivitySummary activity) => new()
    {
      ActivityType = activity.ActivityType,
      Category = activity.Category,
      DangerLevel = activity.DangerLevel ?? QuestDangerLevel.Standard,
      MinLevel = activity.MinLevel,
      MaxLevel = activity.MaxLevel,
      RateMin = activity.RateMin,
      RateMax = activity.RateMax,
      RecommendedDurationDays = activity.RecommendedDurationDays,
      Description = activity.Description,
      BalanceNote = activity.BalanceNote ?? ""
    };
  }
}
