@* Пагинация «← Назад / Стр. N из M / Дальше →» — та же разметка catalog-pagination, что у
   каталога и /admin/items, для страниц, которые листают уже загруженный в память список.
   Не рендерится, если всё помещается на одну страницу. *@

@if (TotalCount > PageSize)
{
  <div class="catalog-pagination">
    <button type="button" disabled="@(PageNumber <= 1)" @onclick="() => PageNumberChanged.InvokeAsync(PageNumber - 1)">← Назад</button>
    <span>Стр. @PageNumber из @PageCount</span>
    <button type="button" disabled="@(PageNumber >= PageCount)" @onclick="() => PageNumberChanged.InvokeAsync(PageNumber + 1)">Дальше →</button>
  </div>
}

@code {
  /// <summary>Текущая страница (с 1).</summary>
  [Parameter] public int PageNumber { get; set; } = 1;

  [Parameter] public EventCallback<int> PageNumberChanged { get; set; }

  /// <summary>Строк на страницу.</summary>
  [Parameter, EditorRequired] public int PageSize { get; set; }

  /// <summary>Всего строк после фильтрации.</summary>
  [Parameter, EditorRequired] public int TotalCount { get; set; }

  private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
}
