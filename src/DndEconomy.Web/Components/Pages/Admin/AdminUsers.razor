@page "/admin/users"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using DndEconomy.Application.Users
@using DndEconomy.Domain.Constants
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IAdminUserService AdminUserService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>Пользователи — админка Relaxerr</PageTitle>
<ToastContainer />

<h1>Пользователи</h1>
<AdminNav />

@if (errors.Count > 0)
{
  <div class="status-message status-message--error">
    @foreach (var error in errors)
    {
      <p>@error</p>
    }
  </div>
}

<div class="admin-two-col">
  <section class="auth-card admin-two-col__wide">
    <h2>Все пользователи</h2>
    @if (users is null)
    {
      <p>Загрузка...</p>
    }
    else
    {
      @foreach (var user in users)
      {
        <p class="catalog-meta admin-user-row">
          <span>
            <strong>@user.DisplayName</strong> (@user.Email) — @string.Join(", ", user.Roles)
            @if (user.MustChangePassword)
            {
              <text> · ждёт смены временного пароля</text>
            }
          </span>
          @if (user.Id != currentUserId)
          {
            <button class="btn admin-user-row__delete" @onclick="() => DeleteUserAsync(user)">Удалить</button>
          }
        </p>
      }
    }
  </section>

  <section class="auth-card">
    <h2>Пригласить пользователя</h2>
    <EditForm Model="newUser" OnValidSubmit="InviteAsync">
      <DataAnnotationsValidator />
      <ValidationSummary class="validation-summary" />

      <div class="form-field">
        <label for="Email">Email</label>
        <InputText @bind-Value="newUser.Email" id="Email" />
      </div>
      <div class="form-field">
        <label for="DisplayName">Отображаемое имя</label>
        <InputText @bind-Value="newUser.DisplayName" id="DisplayName" />
      </div>
      <div class="form-field">
        <label for="TemporaryPassword">Временный пароль</label>
        <InputText @bind-Value="newUser.TemporaryPassword" id="TemporaryPassword" />
      </div>
      <div class="form-field">
        <label for="Role">Роль</label>
        <InputSelect @bind-Value="newUser.Role" id="Role">
          <option value="@RoleNames.Player">Игрок</option>
          <option value="@RoleNames.Admin">Администратор</option>
        </InputSelect>
      </div>

      <button type="submit" class="btn btn--primary">Создать</button>
    </EditForm>
  </section>
</div>

@code {
  [CascadingParameter]
  private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

  private IReadOnlyList<UserSummary>? users;
  private List<string> errors = [];
  private Guid currentUserId;
  private NewUserModel newUser = new();

  protected override async Task OnInitializedAsync()
  {
    if (AuthenticationStateTask is not null)
    {
      var authState = await AuthenticationStateTask;
      var userIdString = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
      Guid.TryParse(userIdString, out currentUserId);
    }

    users = await AdminUserService.GetUsersAsync(CancellationToken.None);
  }

  private async Task InviteAsync()
  {
    errors = [];

    var result = await AdminUserService.InviteUserAsync(
      currentUserId, newUser.Email, newUser.DisplayName, newUser.TemporaryPassword, newUser.Role, CancellationToken.None);

    if (result.Count > 0)
    {
      errors = result.ToList();
      return;
    }

    newUser = new();
    users = await AdminUserService.GetUsersAsync(CancellationToken.None);
    ToastService.ShowSuccess("Пользователь создан");
  }

  private async Task DeleteUserAsync(UserSummary user)
  {
    var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить пользователя «{user.DisplayName}» ({user.Email}) безвозвратно?");
    if (!confirmed)
      return;

    errors = [];
    var result = await AdminUserService.DeleteUserAsync(currentUserId, user.Id, CancellationToken.None);
    if (result.Count > 0)
    {
      errors = result.ToList();
      return;
    }

    users = await AdminUserService.GetUsersAsync(CancellationToken.None);
    ToastService.ShowSuccess("Пользователь удалён");
  }

  private sealed class NewUserModel
  {
    [Required, EmailAddress]
    public string Email { get; set; } = "";

    [Required]
    public string DisplayName { get; set; } = "";

    [Required]
    public string TemporaryPassword { get; set; } = "";

    public string Role { get; set; } = RoleNames.Player;
  }
}
