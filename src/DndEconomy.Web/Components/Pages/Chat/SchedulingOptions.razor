@using DndEconomy.Domain.Collaboration
<div class="scheduling-options">
  <label>Горизонт, дней (7–60)<input type="number" min="7" max="60" @bind="Settings.HorizonDays" /></label>
  <label>Длительность, минут<input type="number" min="30" max="1440" @bind="Settings.DurationMinutes" /></label>
  <label>Шаг старта, минут<input type="number" min="15" max="240" @bind="Settings.StepMinutes" /></label>
  <label>Минимум игроков без мастера<input type="number" min="1" max="20" @bind="Settings.MinimumPlayers" /></label>
  <label>Формат<select @bind="Settings.Format"><option value="@PlayFormat.Both">Оба</option><option value="@PlayFormat.Online">Онлайн</option><option value="@PlayFormat.Offline">Офлайн</option></select></label>
  <details><summary>Пределы опоздания и вес оценки</summary>
    <label>4 участника: один до, минут<input type="number" @bind="Settings.FourLateMinutes" /></label>
    <label>5 участников: один до, минут<input type="number" @bind="Settings.FiveLateMinutes" /></label>
    <label>6 и более: до, минут<input type="number" @bind="Settings.SixLateMinutes" /></label>
    <label>6 и более: число опоздавших<input type="number" @bind="Settings.SixLateCount" /></label>
    <label>Баллов штрафа за час опоздания<input type="number" step="0.1" @bind="Settings.LatenessWeight" /></label>
  </details>
</div>
@code { [Parameter, EditorRequired] public SchedulingSettings Settings { get; set; } = default!; }
