@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using DndEconomy.Application.Notifications
@using DndEconomy.Domain.Constants
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService

<div class="app-shell">
  <header class="app-header">
    <a class="app-header__title" href="/">Relaxerr · Экономика</a>

    <nav class="app-header__nav">
      <AuthorizeView>
        <Authorized>
          <a href="/catalog">Каталог</a>
          <a href="/profile">Профиль</a>
          <a href="/notifications">Уведомления@(unreadCount > 0 ? $" ({unreadCount})" : "")</a>
          @if (context.User.IsInRole(RoleNames.Admin))
          {
            <a href="/admin/requests">Админка</a>
          }
          <span class="app-header__user">@context.User.Identity?.Name</span>
          <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <button type="submit" class="app-header__logout">Выйти</button>
          </form>
        </Authorized>
        <NotAuthorized>
          <a href="Account/Login">Войти</a>
        </NotAuthorized>
      </AuthorizeView>
    </nav>
  </header>

  <main class="app-content">
    @Body
  </main>
</div>

@code {
  private string? currentUrl;
  private int unreadCount;

  [CascadingParameter]
  private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

  protected override async Task OnInitializedAsync()
  {
    currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    NavigationManager.LocationChanged += OnLocationChanged;
    await RefreshUnreadCountAsync();
  }

  private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
    await RefreshUnreadCountAsync();
    await InvokeAsync(StateHasChanged);
  }

  // Без live-пуша (SignalR) — счётчик пересчитывается при каждой навигации, этого достаточно
  // для закрытой кампании на несколько игроков.
  private async Task RefreshUnreadCountAsync()
  {
    if (AuthenticationStateTask is null)
      return;

    var authState = await AuthenticationStateTask;
    var userIdString = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (userIdString is not null && Guid.TryParse(userIdString, out var userId))
      unreadCount = await NotificationService.GetUnreadCountAsync(userId, CancellationToken.None);
  }

  public void Dispose()
  {
    NavigationManager.LocationChanged -= OnLocationChanged;
  }
}
