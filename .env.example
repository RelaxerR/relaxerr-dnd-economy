POSTGRES_DB=dnd_economy
POSTGRES_USER=dnd_economy
POSTGRES_PASSWORD=CHANGE_ME

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME

# Статичные ключи для макросов Foundry VTT (см. foundry-macros/) — генерировать например
# `openssl rand -base64 32`, вписывать в сам макрос в Foundry, не в этот файл.
MACRO_API_PLAYER_KEY=CHANGE_ME
MACRO_API_ADMIN_KEY=CHANGE_ME

ASPNETCORE_ENVIRONMENT=Production
